# ==============================================================================
# MEDIGRID FULL-STACK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace secrets with secure production values.
# ==============================================================================

# Node Environment (development | production | test)
NODE_ENV=development

# Super Admin Master Authentication Credentials
ADMIN_EMAIL=admin@medigrid.com
ADMIN_PASSWORD=change_this_to_a_secure_master_password

# Database & Cache Ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database & Cache Connection Strings
DATABASE_URL=postgres://medigrid:change_this_db_password@localhost:5432/medigrid_db
REDIS_HOST=127.0.0.1
REDIS_URL=redis://localhost:6379

# Microservices Service Ports
PHARMACY_SERVICE_PORT=5001
ORDER_SERVICE_PORT=5002

# Inter-service Communication URLs
PHARMACY_SERVICE_URL=http://localhost:5001
CATALOG_SERVICE_URL=http://localhost:5001

# Next.js Frontend Client-Side Endpoints
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:5001
NEXT_PUBLIC_BILLING_API_URL=http://localhost:5002
